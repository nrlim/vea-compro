# ── PT Vanguard Energy Amanah (PT VEA) — Production Environment Variables ────
# Runtime-only values. NODE_ENV, PORT, and HOSTNAME are set by Dockerfile/docker-compose.yml.

# Public site URL used for metadata
NEXT_PUBLIC_SITE_URL="https://ptvea.com"

# PostgreSQL exposed on host by existing containers:
# pgbouncer-pooler -> 127.0.0.1:6432, postgres-center -> 127.0.0.1:5432
# Runtime app traffic goes through PgBouncer; Prisma schema sync uses direct Postgres.
# If PgBouncer is >= 1.21, remove `&pgbouncer=true` if it causes issues.
DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:6432/veadb?schema=public&pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@127.0.0.1:5432/veadb?schema=public"

# Admin Authentication
JWT_SECRET="generate_a_secure_random_string_here_minimum_32_characters"

# AES-256 Encryption Key for SMTP Password at Rest (64 hex characters)
# Generate with: openssl rand -hex 32
SMTP_ENCRYPTION_KEY="generate_64_hex_characters_here"

# Optional public WhatsApp fallback; admin DB settings override these when available.
NEXT_PUBLIC_WHATSAPP_NUMBER="6281319994160"
NEXT_PUBLIC_WHATSAPP_MESSAGE="Halo PT VEA, saya ingin berkonsultasi mengenai layanan energi Anda."
